# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: PostgreSQL connection string with PostGIS extension support
DATABASE_URL="postgresql://bhumi_user:secure_password@localhost:5432/bhumi360_db?sslmode=disable"

# AUTH_SECRET: Cryptographic secret for signing session tokens and API JWTs
AUTH_SECRET="bhumi360_super_secure_jwt_secret_change_in_production_2026"

# CORS_ORIGIN: Allowed cross-origin resource sharing origins for API endpoints
CORS_ORIGIN="http://localhost:3000"

# GIS_BASE_URL: Base URL for official government GIS / spatial services
GIS_BASE_URL="https://cadastral.nic.in/geoserver"

# GEOSERVER_URL: OGC WMS / WFS GeoServer endpoint
GEOSERVER_URL="https://geoserver.bhumi.gov.in/geoserver/wfs"

# STORAGE_URL: Secure object storage bucket URL for cadastral deeds and orthomosaics
STORAGE_URL="https://storage.googleapis.com/bhumi360-documents"
